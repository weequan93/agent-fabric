{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "useUnknownInCatchVariables": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": false,
    "types": ["node"],
    "typeRoots": ["./node_modules/@types"],
    "declaration": true,
    "sourceMap": true,
    "noEmitOnError": true,
    "rootDir": "..",
    "outDir": "node_modules/.cache/g1-build"
  },
  "include": ["src/**/*.ts", "tests/**/*.ts"],
  "exclude": ["node_modules", "web", "desktop", "mobile"]
}
