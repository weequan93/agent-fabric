# Loop working evidence (copied candidate trees, native binaries, raw logs; ~8.8 GB). Stays on disk, not in git.
# Kept here, not in the root .gitignore, because an accepted foundation check seals the root file's bytes.
*/develop-turn*/
*/native-attempts/
*/plan-turn*/
# ...except files that checks and g1-storage scripts read
!agent-fabric-g1-f05-storage/develop-turn96/
!agent-fabric-g1-f05-storage/develop-turn150/
agent-fabric-g1-f05-storage/develop-turn150/*
!agent-fabric-g1-f05-storage/develop-turn150/check-retained-failure.mjs
!agent-fabric-g1-f05-storage/develop-turn150/probe-lock-observation.mjs
!agent-fabric-g1-f05-storage/plan-turn55/
!agent-fabric-g1-f05-storage/plan-turn88/
agent-fabric-g1-f05-storage/plan-turn55/*
agent-fabric-g1-f05-storage/plan-turn88/*
!agent-fabric-g1-f05-storage/plan-turn55/repair-case-allocation.json
!agent-fabric-g1-f05-storage/plan-turn88/repair-cases.json
