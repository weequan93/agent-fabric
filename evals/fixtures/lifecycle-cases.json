  "behavioralCases": [
    {
      "id": "controller-owned-completion",
      "input": {
        "controllerGate": true,
        "modelClaim": false
      },
      "expected": "controller gate governs completion"
    },
    {
      "id": "model-claim-not-completion",
      "input": {
        "controllerGate": false,
        "modelClaim": true
      },
      "expected": "run cannot succeed from model claim"
    },
    {
      "id": "notification-result-separation",
      "input": {
        "taskResult": "succeeded",
        "notification": "failed"
      },
      "expected": "task remains succeeded; notification independently failed"
    },
    {
      "id": "ordinary-answer-no-deployment",
      "input": {
        "executionClass": "conversation",
        "intent": "ask",
        "deploymentRequested": false
      },
      "expected": "ordinary valid answer needs no deployment gate"
    },
    {
      "id": "terminal-new-run",
      "input": {
        "oldState": "failed",
        "retryAuthorized": true,
        "oldCharges": 35,
        "oldEvidence": [
          "evidence-1"
        ]
      },
      "expected": {
        "newRunRequired": true,
        "oldRunState": "failed",
        "oldCharges": 35,
        "oldEvidence": [
          "evidence-1"
        ]
      }
    },
    {
      "id": "pure-replay",
      "input": {
        "history": "fixed committed lifecycle events"
      },
      "expected": {
        "modelCalls": 0,
        "writeCalls": 0
      }
    },
    {
      "id": "unknown-before-continuation",
      "input": {
        "effectState": "unknown",
        "currentGrants": true,
        "reconciled": false
      },
      "expected": "reconciling or waiting; no model/write continuation until reconciliation"
    }
  ],
  "laterGatePending": [
    "Actual durable workflow runtime/worker restoration is G1 qualification; deterministic fixture does not certify deployment"
  ]
