{
  "schema_version": "1.0",
  "runtime": {
    "backend": "local",
    "image": null,
    "memory_mb": 512,
    "cpu_millis": 1000,
    "pids_limit": 128,
    "tmp_mb": 128,
    "uid": 1000,
    "gid": 1000
  },
  "model": {
    "provider": "openai",
    "model": "set-your-model-id",
    "api_key_env": "OPENAI_API_KEY",
    "pricing": null
  },
  "response_limits": {
    "max_output_tokens": 8192,
    "timeout_seconds": 600,
    "max_request_bytes": 524288,
    "max_response_bytes": 2097152,
    "final_reserve_tokens": 0,
    "final_reserve_cost_microunits": 0
  },
  "evaluator_keys": [],
  "stages": [
    {
      "id": "delivery",
      "depends_on": [],
