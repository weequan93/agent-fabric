        "async-contracts",
        "real-postgres",
        "migration-and-ledger",
        "prior-baselines"
      ],
      "write_allow": [
        "g1-foundations/**",
        "docs/planning/g1-remaining-ledger.csv",
        "docs/planning/g1-foundations-plan.md",
        "docs/operations/g1-foundations-quickstart.md"
      ],
      "write_deny": [
        ".git/**",
        ".loop/**",
        ".agents/**",
        ".codex/**",
        "g1-local/**",
        "engine/**",
        "security/**",
        "services/**",
        "adapters/**",
        "apps/**",
        "execution/**",
        "evals/**",
        "infra/**",
        "scripts/**",
        "package.json",
        "pnpm-lock.yaml",
        "pnpm-workspace.yaml",
        "tsconfig*.json",
        "docs/evidence/**",
        "docs/planning/roadmap.md",
        "docs/planning/g0-implementation-plan.md",
        "docs/planning/decision-register.md",
        "docs/planning/requirements-traceability.csv",
        "docs/planning/g1-local*.md",
