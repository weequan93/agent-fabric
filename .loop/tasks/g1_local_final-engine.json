        "docs/architecture/interface-registry.md",
        "docs/architecture/client-and-module-contracts.md",
        "docs/evidence/g0-*",
        "docs/operations/g0-*",
        "engine/**",
        "security/**",
        "services/**",
        "execution/**",
        "adapters/**",
        "apps/**",
        "infra/migrations/0001_core_records.sql",
        "evals/**",
        "scripts/**",
        "package.json",
        "pnpm-lock.yaml",
        "pnpm-workspace.yaml",
        "tsconfig*.json",
        ".git/**",
