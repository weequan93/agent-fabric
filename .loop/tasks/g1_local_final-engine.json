{
  "schema_version": "1.0",
  "runtime": {
    "backend": "local",
    "image": null,
    "memory_mb": 512,
    "cpu_millis": 1000,
    "pids_limit": 128,
    "tmp_mb": 128,
    "uid": 1000,
    "gid": 1000
  },
  "model": {
    "provider": "openai",
    "model": "set-your-model-id",
    "api_key_env": "OPENAI_API_KEY",
    "pricing": null
  },
  "response_limits": {
    "max_output_tokens": 4096,
    "timeout_seconds": 600,
    "max_request_bytes": 1048576,
    "max_response_bytes": 2097152,
    "final_reserve_tokens": 0,
    "final_reserve_cost_microunits": 0
  },
  "evaluator_keys": [
    {
      "key_id": "team-coordinator-reviewer",
      "role": "reviewer",
      "check_ids": [
        "team-independent-security",
        "team-independent-reviewer",
        "team-independent-acceptance"
      ]
    }
  ],
  "stages": [
    {
      "id": "delivery",
      "depends_on": [],
      "criterion_ids": [
        "criterion-1",
        "criterion-2",
        "criterion-3",
        "team-independent-security",
        "team-independent-reviewer",
        "team-independent-acceptance"
      ],
      "write_allow": [
        "docs/evidence/g1-local-acceptance.json",
        "docs/evidence/g1-local-acceptance.md"
      ],
      "write_deny": [
        "README.md",
        "docs/planning/roadmap.md",
        "docs/planning/g0-implementation-plan.md",
        "docs/planning/decision-register.md",
        "docs/planning/requirements-traceability.csv",
